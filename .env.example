VITE_GRAPHQL_URL=/graphql
# Optional HTTP(S) API origin for cover writes; blank uses the storefront proxy.
VITE_API_URL=
# Local demo buttons (development on loopback hosts only). Seed the backend first.
VITE_DEMO_LOGIN=false
# Enable only after deploying the compatible notification API and stream proxy.
VITE_IN_APP_NOTIFICATIONS_ENABLED=false
